# Rust
/target/

# Dependencies and web build output
inspector/node_modules/
inspector/dist/

# Tests, reports, and local artifacts
/artifacts/
/out/
*.log

# Fetched clips. The fetch scripts and their hashes are tracked; the video
# never is.
/corpus/clips/
*.y4m

# Encoder output. Conformance streams and crash regressions are tracked.
*.kfv
!conformance/**/*.kfv

# Editors and operating systems
.idea/
.vscode/
.DS_Store
Thumbs.db

# The projection room's dependencies and build output, plus the two runtime
# files `scripts/build-inspector.sh` produces: the decoder module is a build
# artifact and the sample clip is a copy of a committed conformance stream.
inspector/node_modules/
inspector/dist/
inspector/public/kf_wasm.wasm
inspector/public/sample.kfv
inspector/public/cutting-room.json
inspector/public/rd-campaign.json
inspector/public/regressions/
inspector/test-results/
inspector/playwright-report/
